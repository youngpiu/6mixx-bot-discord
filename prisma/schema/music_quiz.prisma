model MusicQuizSong {
  id        Int      @id @default(autoincrement())
  title     String
  aliases   String[]
  singer    String
  album     String?
  opusUrl   String   @unique
  songUrl   String?  // Original link to the song (YouTube, Spotify, etc.)
  thumbUrl  String?  // Thumbnail image URL
  duration  Int?     // Duration in seconds

  // Statistics displayed in UI (Record, Avg Time, Correct %)
  totalAttempts   Int     @default(0)
  correctAttempts Int     @default(0)
  avgGuessTime    Float   @default(0)
  
  bestGuessTime   Float?
  bestGuesserId   String?
  bestGuesser     User?   @relation("BestGuesser", fields: [bestGuesserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bestGuesserId])
}
