model VietnameseWordChainSession {
  id BigInt @id @default(autoincrement())

  guildId   String
  channelId String // channel chơi game
  guild     Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  winnerId String? // người chiến thắng ván chơi này

  winner Member? @relation("WordChainWinner", fields: [guildId, winnerId], references: [guildId, id])

  endedAt DateTime?

  players VietnameseWordChainSessionPlayer[]

  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([guildId, channelId])
}