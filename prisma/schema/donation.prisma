enum DonationStatus {
  PENDING
  CONFIRMED
}

model Donation {
  id      String @id @default(cuid())
  code    String @unique 
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  donorId     String
  donor       Member  @relation("Donor", fields: [guildId, donorId], references: [guildId, userId])
  amount      Int
  message     String? 

  status      DonationStatus @default(PENDING)
  confirmedAt DateTime?
  confirmedBy String?
  confirmer   Member? @relation("Confirmer", fields: [guildId, confirmedBy], references: [guildId, userId])

  createdAt DateTime @default(now())

  @@index([guildId, code])
  @@index([guildId, status])
  @@index([guildId, createdAt(sort: Desc)])
  @@index([guildId, donorId])
}

