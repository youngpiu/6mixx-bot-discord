model Guild {
  id      String @id @default(cuid())
  guildId String @unique


  // Ticket config
  ticketChannelId         String?
  ticketTutorialMessageId String?

  // Confession config
  confessionNotificationChannelId String?
  confessionForumChannelId        String?
  confessionTutorialThreadId      String?

  // Donation config
  donationNotificationChannelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members     Member[]
  tickets     Ticket[]
  donations   Donation[]
  expenses    Expense[]
  confessions Confession[]
}
