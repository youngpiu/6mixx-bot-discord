/// Server identity
model Guild {
  id String @id // guildId in discordjs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// --- Relations ---
  setting                 GuildSetting?
  guildMembers            GuildMember[]
  tickets                 Ticket[]
  autoIncrements          AutoIncrement[]
  donations               Donation[]
  disbursements           Disbursement[]
  confessions             Confession[]
  wordChainSessions       WordChainSession[]
  tempVoiceProfiles       TempVoiceProfile[]
  tempVoiceTrustedMembers TempVoiceTrustedMember[]
  tempVoiceTrustedRoles   TempVoiceTrustedRole[]
  tempVoiceDeniedMembers  TempVoiceDeniedMember[]
}

/// Server Settings (1-to-1 with Guild)
model GuildSetting {
  id String @id @default(cuid())

  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  /// --- General Config ---
  serviceForumChannelId      String?
  notificationForumChannelId String?
  vipTutorialThreadId        String?
  errorNotificationThreadId  String?

  /// --- Ticket Config ---
  ticketCategoryId           String?
  ticketTutorialThreadId     String?
  ticketNotificationThreadId String?

  /// --- Confession Config ---
  confessionForumChannelId       String?
  confessionTutorialThreadId     String?
  confessionNotificationThreadId String?

  /// --- Donation Config ---
  donationTutorialThreadId     String?
  donationNotificationThreadId String?
  disbursementLogChannelId     String?

  /// --- Word Chain Config ---
  vietnameseWordChainChannelId String?
  englishWordChainChannelId    String?

  /// --- Temp Voice Config ---
  tempVoiceCreateChannelId String?
  tempVoiceCategoryId      String?

  /// --- iChart Config ---
  ichartSongId   String?
  ichartSongName String?

  /// --- VIP Config ---
  vipAnchorRoleId String?

  /// --- Nmixx Forum Config ---
  nmixxSingleForumChannelId String?
  nmixxOtpForumChannelId    String?
  nmixxTutorialThreadId     String?

  nmixxQuizAnswerChannelId   String?
  nmixxQuizVoiceChannelId    String?

  /// --- Youtube Notification Config ---
  youtubeNotificationListenChannelId String?
  youtubeNotificationPostChannelId   String?
  youtubeNotificationRoleId           String?
  youtubeNotificationAllowedRoleIds   String[] @default([])

  /// --- Twitter Config ---
  weNmixxNotificationChannelId      String?
  weNmixxNotificationRoleId         String?
  weNmixxNotificationAllowedRoleIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
