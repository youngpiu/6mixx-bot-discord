/// Server identity
model Guild {
  id String @id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// --- Relations ---
  setting        GuildSetting?
  members        Member[]
  tickets        Ticket[]
  autoIncrements AutoIncrement[]
  donations      Donation[]
  disbursements  Disbursement[]
  confessions    Confession[]
}
