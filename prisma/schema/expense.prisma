model Expense {
  id          String @id @default(cuid())
  code        String @unique
  guildId     String
  guild       Guild  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  amount      Int
  description String

  createdBy   String
  creator     Member @relation(fields: [guildId, createdBy], references: [guildId, userId])

  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([guildId, createdAt(sort: Desc)])
}
