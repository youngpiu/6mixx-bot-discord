/// User in a guild
model Member {
  id String

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  /// --- Relations ---
  ticketsCreated Ticket[] @relation("TicketRequester")
  ticketsClosed  Ticket[] @relation("TicketCloser")

  donations Donation[] @relation("Donor")

  confessions         Confession[]
  confessionsApproved Confession[] @relation("ConfessionApprover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([guildId, id])
  @@index([guildId])
}
