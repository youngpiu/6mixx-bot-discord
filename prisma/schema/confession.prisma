/// Status of a confession
enum ConfessionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// User Confession
model Confession {
  id String @id @default(cuid())

  /// Unique Code (e.g. CFS-1)
  code String @unique

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  /// Content of the confession
  content     String
  isAnonymous Boolean @default(true)

  status          ConfessionStatus @default(PENDING)
  rejectionReason String?
  forumPostId     String?

  authorId String
  author   Member @relation(fields: [guildId, authorId], references: [guildId, id])

  approvedBy String?
  approver   Member? @relation("ConfessionApprover", fields: [guildId, approvedBy], references: [guildId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([guildId, status])
}
