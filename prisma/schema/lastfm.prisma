model LastFmAccount {
  userId         String @id
  lastfmUsername String @unique
  totalScrobbles Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LastFmUserArtistLibrary {
  userId     String
  artistName String
  playCount  Int
  updatedAt  DateTime @updatedAt

  @@id([userId, artistName])
  @@index([artistName])
}
