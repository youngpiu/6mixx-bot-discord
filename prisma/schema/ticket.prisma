enum TicketType {
  FEEDBACK
  REPORT
  BUG
}

enum TicketStatus {
  OPEN
  CLOSED
}

model Ticket {
  id String @id @default(cuid())

  guildId     String
  guild       Guild   @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  threadId   String  @unique
  firstMessageId String?
  requesterId String
  requester   Member  @relation("TicketRequester", fields: [guildId, requesterId], references: [guildId, userId])
  closedBy    String?
  closer      Member? @relation("TicketCloser", fields: [guildId, closedBy], references: [guildId, userId])

  type   TicketType   @default(FEEDBACK)
  status TicketStatus @default(OPEN)
  code   String       @unique
  reason String?

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, type])
  @@index([guildId, code])
  @@index([guildId, status])
  @@index([guildId, createdAt(sort: Desc)])
}
