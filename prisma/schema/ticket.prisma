/// Ticket type
enum TicketType {
  FEEDBACK
  REPORT
  BUG
}

/// Ticket status
enum TicketStatus {
  OPEN
  CLOSED
}

/// Support Ticket System
model Ticket {
  id String @id @default(cuid())

  /// Unique ticket code (e.g. T-123)
  code String

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  /// Discord Channel ID
  channelId String @unique

  type   TicketType   @default(FEEDBACK)
  status TicketStatus @default(OPEN)

  reason   String?
  closedAt DateTime?

  requesterId String
  requester   GuildMember @relation("TicketRequester", fields: [guildId, requesterId], references: [guildId, userId], onDelete: Restrict)

  closedBy String?
  closer   GuildMember? @relation("TicketCloser", fields: [guildId, closedBy], references: [guildId, userId], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, code])
  @@index([guildId, type])
  @@index([guildId, status])
  @@index([guildId, createdAt(sort: Desc)])
  @@index([guildId, requesterId])
}
