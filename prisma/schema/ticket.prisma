enum TicketType {
  FEEDBACK
  REPORT
  BUG
}

model Ticket {
  id String @id @default(cuid())

  guildId     String   
  threadId    String  @unique
  requesterId String   
  closedById  String?  

  type        TicketType   @default(FEEDBACK)
  code        String       @unique
  reason      String?

  closedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
