/// Ticket type
enum TicketType {
  FEEDBACK
  REPORT
  BUG
}

/// Ticket status
enum TicketStatus {
  OPEN
  CLOSED
}

/// Support Ticket System
model Ticket {
  id String @id @default(cuid())

  /// Unique ticket code (e.g. T-123)
  code String @unique

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  /// Discord Channel ID
  channelId String @unique

  type   TicketType   @default(FEEDBACK)
  status TicketStatus @default(OPEN)

  reason   String?
  closedAt DateTime?

  requesterId String
  requester   Member @relation("TicketRequester", fields: [guildId, requesterId], references: [guildId, id])

  closedBy String?
  closer   Member? @relation("TicketCloser", fields: [guildId, closedBy], references: [guildId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, type])
  @@index([guildId, code])
  @@index([guildId, status])
  @@index([guildId, createdAt(sort: Desc)])
}
