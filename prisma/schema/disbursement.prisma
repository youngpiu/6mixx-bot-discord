model Disbursement {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  amount         Int
  description    String
  attachmentUrls String[]
  messageUrl     String?

  createdAt DateTime @default(now())

  @@index([guildId, createdAt(sort: Desc)])
}
