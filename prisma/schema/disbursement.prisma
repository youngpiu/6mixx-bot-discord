model Disbursement {
  id String @id @default(cuid())

  /// Unique Tracking Code
  code String @unique

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  amount      Int
  description String
  messageUrl  String

  createdAt DateTime @default(now())

  @@index([guildId, code])
  @@index([guildId, createdAt(sort: Desc)])
}
