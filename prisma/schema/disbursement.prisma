model Disbursement {
  id String @id @default(cuid())

  /// Unique Tracking Code
  code String

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  amount      Int
  description String
  messageUrl  String

  createdAt DateTime @default(now())

  @@index([guildId, createdAt(sort: Desc)])
  @@unique([guildId, code])
}
