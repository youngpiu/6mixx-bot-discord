# ===========================================
# Environment Variables
# Copy this file to .env and fill in the values
# ===========================================

# ── Database ────────────────────────────────
POSTGRES_USER="admin"
POSTGRES_PASSWORD="your-strong-password-here"
POSTGRES_DB="6mixx"
DATABASE_URL="postgresql://admin:your-strong-password-here@localhost:5432/6mixx?schema=public"

# ── Redis ───────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Discord Bot ─────────────────────────────
DISCORD_TOKEN="your-token-here"
TEST_GUILDS_ID="your-main-guild-id,your-test-guild-id"
OWNER_BOT_ID="your-discord-id-here"

# ── Bot Settings ────────────────────────────
DEFAULT_PREFIX="."
NODE_ENV="development"

# ── Bank (for donation feature) ─────────────
BANK_ACCOUNT_NUMBER="your-bank-account-number"
BANK_NAME="your-bank-name"
BANK_ACCOUNT_NAME="your-bank-account-name"